datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  symbol    String       @id
  name      String
  sector    String
  prices    DailyPrice[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model DailyPrice {
  id        Int      @id @default(autoincrement())
  symbol    String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  company   Company  @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
}
