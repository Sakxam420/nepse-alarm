datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  symbol    String       @id
  name      String
  sector    String
  prices    DailyPrice[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model DailyPrice {
  id        Int      @id @default(autoincrement())
  symbol    String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  company   Company  @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
}

model Alert {
  id          String    @id @default(uuid())
  symbol      String
  condition   String    // 'ABOVE', 'BELOW', 'RSI_OVERSOLD', 'RSI_OVERBOUGHT', 'MACD_CROSSOVER', 'PCT_CHANGE_UP', 'PCT_CHANGE_DOWN'
  targetValue Float
  isActive    Boolean   @default(true)
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([symbol])
  @@index([isActive])
}

model PortfolioPosition {
  id        String   @id @default(uuid())
  symbol    String
  buyPrice  Float
  quantity  Float
  buyDate   DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
}
