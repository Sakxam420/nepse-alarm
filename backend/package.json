{
  "name": "nepse-alarm-backend",
  "version": "1.0.0",
  "description": "NestJS backend for NEPSE AI Prediction and Decision Support System",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
